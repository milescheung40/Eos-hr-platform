# AI 大模型（仅服务端读取，勿提交 .env 到版本库）
AI_ENABLED=false
AI_PROVIDER=deepseek
AI_API_KEY=
# 官方 OpenAI 兼容 base URL（文档: https://api-docs.deepseek.com/）
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=10000
AI_MAX_TOKENS=1024

# 可选：数据库与 JWT
# DB_PATH=eos_hr.db
# JWT_SECRET=change-me-in-production
# PORT=3000
